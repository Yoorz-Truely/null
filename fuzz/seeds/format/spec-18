action @hop "Hop" {
  use-cyclic
  slot @ball object "Ball"
  layer @base "Base" {
    strip @keys keyframe {
      channels @ball {
        fcurve location index=2 {
          extrapolation linear
          key 1 0m
          key 12 1.5m interpolation=sine easing=ease-out
          key 24 0m handle-left=[20 0.4] handle-right=[28 0.4]
        }
      }
    }
  }
}

object @ball "Ball" {
  track @moves "Moves" {
    strip @hop-twice "Hop" {
      action @hop slot=@ball
      frame-start 1
      repeat 2
      blend-type add
    }
  }
}
