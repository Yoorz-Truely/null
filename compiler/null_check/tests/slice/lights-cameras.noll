object @shot-cam "ShotCam" {
  location [6m -12m 2.1m]
  rotation-euler [82deg 0deg 26.5deg]
  data camera @lens
}

camera @lens "Lens" {
  type persp
  lens 35mm
  clip-start 0.1m
  clip-end 1000m
}

object @lamp "Lamp" { location [0.4m -2m 1.8m]; data light @lamp-light }

light @lamp-light "LampLight" {
  type point
  energy 800W
  color [1 0.78 0.52]
  shadow-soft-size 25mm
}

object @sun "Sun" { rotation-euler [45deg 0deg -30deg]; data light @sunlight }

light @sunlight "Sun" {
  type sun
  energy 2.5
  angle 0.5deg
}
